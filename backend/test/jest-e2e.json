{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/../tsconfig.spec.json",
        "diagnostics": true
      }
    ]
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^test/(.*)$": "<rootDir>/$1"
  },
  "setupFilesAfterEnv": [
    "<rootDir>/setup.ts"
  ],
  "testTimeout": 60000,
  "forceExit": true,
  "detectOpenHandles": true,
  "verbose": true,
  "maxWorkers": 1,
  "bail": 1,
  "collectCoverage": false,
  "coverageDirectory": "../coverage/e2e",
  "coverageReporters": [
    "text",
    "html",
    "lcov"
  ],
  "testPathIgnorePatterns": [
    "/node_modules/",
    "/dist/"
  ],
  "moduleDirectories": [
    "node_modules",
    "<rootDir>/../src"
  ],
  "reporters": [
    "default",
    "jest-junit"
  ],
  "clearMocks": true,
  "restoreMocks": true
}