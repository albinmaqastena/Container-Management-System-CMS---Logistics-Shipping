{
  "name": "backend",
  "version": "0.0.1",
  "description": "Container Management System Backend",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:dev:local": "cross-env NODE_ENV=development node -r dotenv/config dist/main.js",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "start:test": "cross-env NODE_ENV=test nest start --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "cross-env NODE_ENV=test jest",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:cov": "cross-env NODE_ENV=test jest --coverage",
    "test:debug": "cross-env NODE_ENV=test node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env NODE_ENV=test jest --config ./test/jest-e2e.json --runInBand --forceExit --verbose",
    "test:e2e:watch": "cross-env NODE_ENV=test jest --config ./test/jest-e2e.json --watch",
    "test:e2e:debug": "cross-env NODE_ENV=test jest --config ./test/jest-e2e.json --runInBand --detectOpenHandles",
    "test:ci": "cross-env NODE_ENV=test npm run test:cov -- --ci --runInBand && npm run test:e2e -- --ci",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "typeorm:dev": "cross-env NODE_ENV=development npm run typeorm",
    "typeorm:test": "cross-env NODE_ENV=test npm run typeorm",
    "typeorm:prod": "typeorm",
    "migration:generate": "cross-env NODE_ENV=development npm run typeorm -- migration:generate -d src/data-source.ts",
    "migration:generate:test": "cross-env NODE_ENV=test npm run typeorm -- migration:generate -d src/data-source.ts",
    "migration:generate:prod": "cross-env NODE_ENV=production npm run typeorm -- migration:generate -d src/data-source.ts",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "cross-env NODE_ENV=development npm run typeorm -- migration:run -d src/data-source.ts",
    "migration:run:test": "cross-env NODE_ENV=test npm run typeorm -- migration:run -d src/data-source.ts",
    "migration:run:prod": "cross-env NODE_ENV=production typeorm migration:run -d dist/data-source.js",
    "migration:revert": "cross-env NODE_ENV=development npm run typeorm -- migration:revert -d src/data-source.ts",
    "migration:revert:test": "cross-env NODE_ENV=test npm run typeorm -- migration:revert -d src/data-source.ts",
    "migration:revert:prod": "cross-env NODE_ENV=production typeorm migration:revert -d dist/data-source.js",
    "migration:show": "cross-env NODE_ENV=development npm run typeorm -- migration:show -d src/data-source.ts",
    "migration:show:test": "cross-env NODE_ENV=test npm run typeorm -- migration:show -d src/data-source.ts",
    "migration:show:prod": "cross-env NODE_ENV=production typeorm migration:show -d dist/data-source.js",
    "seed:create": "ts-node src/seeds/create-seed.ts",
    "seed:run": "cross-env NODE_ENV=development ts-node src/seeds/run-seed.ts",
    "seed:run:test": "cross-env NODE_ENV=test ts-node src/seeds/run-seed.ts",
    "seed:run:prod": "cross-env NODE_ENV=production node dist/seeds/run-seed.js",
    "db:drop": "cross-env NODE_ENV=development npm run typeorm -- schema:drop -d src/data-source.ts",
    "db:drop:test": "cross-env NODE_ENV=test npm run typeorm -- schema:drop -d src/data-source.ts",
    "db:reset:test": "cross-env NODE_ENV=test npm run db:drop:test && npm run migration:run:test",
    "db:reset:dev": "cross-env NODE_ENV=development npm run db:drop && npm run migration:run",
    "db:setup:test": "cross-env NODE_ENV=test npm run db:reset:test && npm run seed:run:test",
    "db:setup:dev": "cross-env NODE_ENV=development npm run db:reset:dev && npm run seed:run",
    "clean": "rimraf dist coverage",
    "prebuild": "npm run clean",
    "env:check": "node -e \"console.log('NODE_ENV:', process.env.NODE_ENV, 'DB:', process.env.DB_DATABASE)\"",
    "env:check:test": "cross-env NODE_ENV=test node -e \"console.log('NODE_ENV:', process.env.NODE_ENV, 'DB:', process.env.DB_DATABASE)\"",
    "env:check:prod": "cross-env NODE_ENV=production node -e \"console.log('NODE_ENV:', process.env.NODE_ENV, 'DB:', process.env.DB_DATABASE)\"",
    "test:all": "npm run test && npm run test:e2e",
    "test:all:cov": "npm run test:cov && npm run test:e2e -- --coverage",
    "dev": "cross-env NODE_ENV=development nest start --watch",
    "dev:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "prod": "node dist/main.js",
    "docker:build": "docker build -t container-backend .",
    "docker:build:prod": "docker build -f Dockerfile.prod -t container-backend:prod .",
    "docker:run": "docker run -p 3000:3000 --env-file .env container-backend",
    "docker:compose:up": "docker-compose up -d",
    "docker:compose:down": "docker-compose down",
    "docker:compose:logs": "docker-compose logs -f",
    "docker:compose:build": "docker-compose build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/s3-request-presigner": "^3.1108.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "argon2": "^0.44.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.79.3",
    "cache-manager": "^7.2.9",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cross-env": "^10.1.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "joi": "^18.2.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.27",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cache-manager": "^4.0.6",
    "@types/compression": "^1.8.1",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.4.2",
    "jest-junit": "^17.0.0",
    "jest-watch-typeahead": "^3.0.1",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/src/**/*.spec.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.spec.json",
          "diagnostics": true
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.spec.ts",
      "!src/main.ts",
      "!src/**/*.module.ts",
      "!src/migrations/**",
      "!src/seeds/**"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1"
    },
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/src"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/test/"
    ],
    "testTimeout": 10000,
    "verbose": true,
    "forceExit": true,
    "detectOpenHandles": true,
    "clearMocks": true,
    "restoreMocks": true
  }
}
