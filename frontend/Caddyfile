{
    admin off

    persist_config off

    auto_https off

    log {
        format json
    }

    servers {
        trusted_proxies static private_ranges 100.0.0.0/8
    }
}

:{$PORT:3000} {
    log {
        format json
    }

    root * /app/build

    encode gzip zstd

    @health path /health

    respond @health "OK" 200

    file_server

    try_files {path} /index.html

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}